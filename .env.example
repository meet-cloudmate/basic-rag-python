# OpenAI (required for embeddings and chat)
OPENAI_API_KEY=sk-your-key-here

# Application
APP_NAME=basic-rag-python
APP_ENV=development
LOG_LEVEL=INFO

# RAG settings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4

# Storage paths (relative to project root)
DOCUMENTS_DIR=data/documents

# Vector store (default: Qdrant)
VECTOR_STORE_BACKEND=qdrant

# Qdrant — local mode (default, no server required)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=data/qdrant
QDRANT_COLLECTION_NAME=rag_documents

# Qdrant — remote mode (set QDRANT_MODE=remote and run a Qdrant server)
# QDRANT_MODE=remote
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
